---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import AirportCard from '../components/AirportCard.astro';
import SearchModal from '../components/SearchModal.astro';
import { SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE, TOP_AIRPORTS, POPULAR_CLIENTS } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${SITE_TITLE} - ${SITE_TAGLINE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<main class="home-main">
			<!-- Hero Section -->
			<section class="hero-section">
				<div class="container hero-container">
					<div class="hero-badge-wrap">
						<span class="badge badge-brand">
							2026 自动化测速与晚高峰实录更新
						</span>
					</div>

					<!-- Hero Title explicitly set to: 2026机场推荐 | 科学上网评测 -->
					<h1 class="hero-title">
						<span class="hero-title-prefix">2026机场推荐</span>
						<span class="hero-title-sep"> | </span>
						<span class="gradient-text">科学上网评测</span>
					</h1>

					<p class="hero-subtitle">
						拒绝任何虚标与频繁卡顿。基于千兆物理双线与晚高峰 20:00~23:00 极限压测，专注甄选具备<strong>真实 IEPL 内网专线</strong>、<strong>住宅原生 IP 解锁 ChatGPT 与全流媒体</strong>的稳定梯子服务商。
					</p>

					<div class="hero-actions">
						<a href="#leaderboard" class="btn btn-primary">
							<span>查看精选天梯榜</span>
							<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
								<polyline points="4 6 8 10 12 6"></polyline>
							</svg>
						</a>
						<a href="/blog/clash-verge-rev-guide/" class="btn btn-secondary">
							<span>新手配置上手教程</span>
						</a>
						<button type="button" class="btn btn-secondary" onclick="document.getElementById('openSearchBtn')?.click()">
							<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2">
								<circle cx="11" cy="11" r="7"></circle>
								<line x1="21" y1="21" x2="16" y2="16"></line>
							</svg>
							<span>即时搜索</span>
						</button>
					</div>
					<!-- Notice: The second image (metrics grid) has been completely removed per user request -->
				</div>
			</section>

			<!-- Airport Leaderboard Showcase -->
			<section class="section leaderboard-section" id="leaderboard">
				<div class="container">
					<div class="section-header">
						<div class="header-left">
							<span class="badge badge-amber">TOP SELECTION</span>
							<h2 class="section-title">2026 优质稳定机场天梯榜</h2>
							<p class="section-desc">拒绝任何无专线基础的劣质云，根据晚高峰测速、工单售后与节点纯净度综合排定。</p>
						</div>
						<div class="header-right">
							<a href="/ranking" class="view-all-link">查看完整多维对比表 ➔</a>
						</div>
					</div>

					<!-- Filter Tabs -->
					<div class="filter-tabs" id="airportFilterTabs">
						<button class="filter-tab active" data-filter="all">全部推荐 ({TOP_AIRPORTS.length})</button>
						<button class="filter-tab" data-filter="主推首选">主推首选</button>
						<button class="filter-tab" data-filter="四端自研">四端自研</button>
						<button class="filter-tab" data-filter="不限时备用">不限时备用</button>
						<button class="filter-tab" data-filter="轻量性价比">轻量性价比</button>
					</div>

					<!-- Cards List -->
					<div class="airports-list" id="airportsList">
						{TOP_AIRPORTS.map((airport, idx) => (
							<AirportCard airport={airport} rank={idx + 1} />
						))}
					</div>
				</div>
			</section>

			<!-- Latest In-depth Reviews & Tutorials -->
			<section class="section articles-section">
				<div class="container">
					<div class="section-header">
						<div class="header-left">
							<span class="badge badge-cyan">GUIDES & REVIEWS</span>
							<h2 class="section-title">最新深度测评与实操指南</h2>
							<p class="section-desc">涵盖底层网络协议科普、客户端配置调优与跑路防坑避雷手册。</p>
						</div>
						<div class="header-right">
							<a href="/blog" class="view-all-link">查看全部文章 ({posts.length}) ➔</a>
						</div>
					</div>

					<div class="articles-grid">
						{posts.map((post) => (
							<a href={`/blog/${post.id}/`} class="article-card glass-panel">
								<div class="article-card-top">
									<span class="badge badge-brand">{post.data.category || '深度评测'}</span>
									<span class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</div>
								
								<h3 class="article-card-title">{post.data.title}</h3>
								
								<p class="article-card-desc">{post.data.description}</p>
								
								<div class="article-card-bottom">
									<div class="article-tags-mini">
										{post.data.tags.slice(0, 3).map((tag: string) => (
											<span class="tag-mini">#{tag}</span>
										))}
									</div>
									<span class="read-more-arrow">阅读全文 ➔</span>
								</div>
							</a>
						))}
					</div>
				</div>
			</section>

			<!-- Client Hub Section -->
			<section class="section clients-section">
				<div class="container">
					<div class="section-header center-header">
						<span class="badge badge-emerald">CROSS PLATFORM</span>
						<h2 class="section-title">全平台科学上网客户端一站式配置</h2>
						<p class="section-desc">适配 Windows、macOS、iOS、Android 与 Linux 全主流系统，选择最适合你的高效客户端。</p>
					</div>

					<div class="clients-grid">
						{POPULAR_CLIENTS.map((client) => (
							<div class="client-card glass-panel">
								<div class="client-card-header">
									<div>
										<h3 class="client-name">{client.name}</h3>
										<span class="client-cat">{client.category}</span>
									</div>
									{client.badge && <span class="badge badge-amber">{client.badge}</span>}
								</div>

								<div class="client-platforms">
									{client.platforms.map((p) => (
										<span class="platform-badge">{p}</span>
									))}
								</div>

								<p class="client-desc">{client.description}</p>

								<div class="client-footer">
									<span class="protocol-hint">支持协议：{client.recommendedProtocol}</span>
									<div class="client-links">
										<a href={`/blog/${client.tutorialSlug}/`} class="btn btn-secondary btn-sm">配置教程</a>
										<a href={client.downloadUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">官方下载 ➔</a>
									</div>
								</div>
							</div>
						))}
					</div>
				</div>
			</section>

			<!-- FAQ Accordion Section -->
			<section class="section faq-section">
				<div class="container prose-container">
					<div class="section-header center-header">
						<span class="badge badge-brand">KNOWLEDGE BASE</span>
						<h2 class="section-title">常见疑问解答 (FAQ)</h2>
						<p class="section-desc">解决大家在挑选机场与配置客户端时最关心的高频问题。</p>
					</div>

					<div class="faq-list">
						<details class="faq-item glass-panel" open>
							<summary class="faq-summary">
								<span>什么是 IEPL 专线？它与普通直连有什么本质区别？</span>
								<span class="faq-chevron">
									<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
										<polyline points="4 6 8 10 12 6"></polyline>
									</svg>
								</span>
							</summary>
							<div class="faq-content">
								<p>
									IEPL（International Ethernet Private Line）是服务商租用的两端实体端对端内网物理光纤。普通直连走公共国际出口，晚高峰由于数千万人争抢带宽，丢包率高达 30% 以上；而 IEPL 专线完全不经过 GFW 公网审查，具备超低延迟、晚高峰零丢包与极度稳定的天然优势。
								</p>
							</div>
						</details>

						<details class="faq-item glass-panel">
							<summary class="faq-summary">
								<span>为什么有些机场能看网页，却打不开 ChatGPT 或 Claude？</span>
								<span class="faq-chevron">
									<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
										<polyline points="4 6 8 10 12 6"></polyline>
									</svg>
								</span>
							</summary>
							<div class="faq-content">
								<p>
									OpenAI 与 Anthropic 部署了严格的反滥用风控体系，对来自亚马逊 AWS、甲骨文等机房的公共服务器 IP 会直接拦截或弹出 1020 报错。要顺畅使用 AI 工具，必须选用配备原生住宅双 ISP IP 的优质机场节点。
								</p>
							</div>
						</details>

						<details class="faq-item glass-panel">
							<summary class="faq-summary">
								<span>新手选购机场，建议买月付还是年付？</span>
								<span class="faq-chevron">
									<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
										<polyline points="4 6 8 10 12 6"></polyline>
									</svg>
								</span>
							</summary>
							<div class="faq-content">
								<p>
									<strong>强烈建议坚持月付或小额季度订阅！</strong> 即使口碑再好的老牌机场，初次使用也建议先购买一个月进行实际网络测试（看本地运营商晚高峰表现）。同时建议常备一个不限时的按量计费套餐作为容灾备用。
								</p>
							</div>
						</details>

						<details class="faq-item glass-panel">
							<summary class="faq-summary">
								<span>客户端开启后国内网站（百度/淘宝）也变慢或打不开了？</span>
								<span class="faq-chevron">
									<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
										<polyline points="4 6 8 10 12 6"></polyline>
									</svg>
								</span>
							</summary>
							<div class="faq-content">
								<p>
									请检查客户端当前是否误开启了「全局模式 (Global)」。请切换回「规则模式 (Rule)」，这样客户端会自动分流：国内网站直接走本地宽带直连，只有海外被屏蔽网站才走代理通道，互不干扰。
								</p>
							</div>
						</details>
					</div>
				</div>
			</section>
		</main>

		<Footer />
		<SearchModal />

		<style>
			.home-main {
				display: flex;
				flex-direction: column;
				gap: 4.5rem;
				padding-bottom: 5rem;
			}

			/* Hero Styling */
			.hero-section {
				padding: 5rem 0 3rem;
				position: relative;
			}

			.hero-container {
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				gap: 1.75rem;
			}

			.hero-title {
				font-size: clamp(2.4rem, 5.5vw, 4.2rem);
				font-weight: 900;
				line-height: 1.15;
				letter-spacing: -0.03em;
				margin: 0;
			}

			.hero-title-prefix {
				color: var(--text-primary);
			}

			.hero-title-sep {
				color: var(--border-highlight);
				font-weight: 300;
				margin: 0 0.2rem;
			}

			.hero-subtitle {
				font-size: clamp(1.1rem, 2vw, 1.25rem);
				color: var(--text-secondary);
				max-width: 820px;
				line-height: 1.8;
				margin: 0;
			}

			.hero-actions {
				display: flex;
				align-items: center;
				gap: 1rem;
				flex-wrap: wrap;
				justify-content: center;
				margin-top: 0.75rem;
			}

			/* Section Header */
			.section-header {
				display: flex;
				align-items: flex-end;
				justify-content: space-between;
				margin-bottom: 2rem;
				gap: 1.5rem;
				flex-wrap: wrap;
			}

			.center-header {
				flex-direction: column;
				align-items: center;
				text-align: center;
			}

			.section-title {
				font-size: clamp(1.7rem, 3.2vw, 2.3rem);
				font-weight: 800;
				margin: 0.5rem 0 0.5rem;
			}

			.section-desc {
				font-size: 1rem;
				color: var(--text-secondary);
				margin: 0;
				max-width: 650px;
			}

			.view-all-link {
				font-weight: 700;
				color: #38bdf8;
				font-size: 0.95rem;
			}

			.view-all-link:hover {
				color: #ffffff;
				text-decoration: underline;
			}

			/* Filter Tabs */
			.filter-tabs {
				display: flex;
				gap: 0.5rem;
				flex-wrap: wrap;
				margin-bottom: 1.75rem;
			}

			.filter-tab {
				padding: 0.6rem 1.2rem;
				background: var(--bg-card);
				border: 1px solid var(--border-subtle);
				color: var(--text-secondary);
				font-size: 0.9rem;
				font-weight: 600;
				cursor: pointer;
				transition: all 0.15s ease;
			}

			.filter-tab:hover {
				background: var(--bg-card-hover);
				color: var(--text-primary);
				border-color: var(--border-strong);
			}

			.filter-tab.active {
				background: var(--text-primary);
				color: var(--bg-primary);
				border-color: var(--text-primary);
				font-weight: 700;
			}

			.airports-list {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}

			/* Articles Grid */
			.articles-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
				gap: 1.75rem;
			}

			.article-card {
				padding: 1.75rem;
				display: flex;
				flex-direction: column;
				gap: 0.85rem;
				text-decoration: none;
				border: 1px solid var(--border-subtle);
			}

			.article-card-top {
				display: flex;
				align-items: center;
				justify-content: space-between;
			}

			.post-date {
				font-size: 0.82rem;
				color: var(--text-muted);
			}

			.article-card-title {
				margin: 0;
				font-size: 1.25rem;
				font-weight: 700;
				color: var(--text-primary);
				line-height: 1.4;
				transition: color 0.15s ease;
			}

			.article-card:hover .article-card-title {
				color: #38bdf8;
			}

			.article-card-desc {
				font-size: 0.92rem;
				color: var(--text-secondary);
				line-height: 1.65;
				margin: 0;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.article-card-bottom {
				margin-top: auto;
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding-top: 1rem;
				border-top: 1px solid var(--border-subtle);
			}

			.article-tags-mini {
				display: flex;
				gap: 0.4rem;
			}

			.tag-mini {
				font-size: 0.76rem;
				color: #60a5fa;
				font-weight: 600;
			}

			.read-more-arrow {
				font-size: 0.88rem;
				font-weight: 700;
				color: #38bdf8;
			}

			/* Clients Grid */
			.clients-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 1.75rem;
			}

			.client-card {
				padding: 1.75rem;
				display: flex;
				flex-direction: column;
				gap: 1.1rem;
				border: 1px solid var(--border-subtle);
			}

			.client-card-header {
				display: flex;
				align-items: flex-start;
				justify-content: space-between;
			}

			.client-name {
				margin: 0;
				font-size: 1.25rem;
				font-weight: 800;
			}

			.client-cat {
				font-size: 0.78rem;
				color: var(--accent-cyan);
				font-weight: 700;
			}

			.client-platforms {
				display: flex;
				gap: 0.4rem;
				flex-wrap: wrap;
			}

			.platform-badge {
				font-size: 0.74rem;
				padding: 0.2rem 0.5rem;
				background: rgba(255, 255, 255, 0.06);
				border: 1px solid var(--border-subtle);
				color: var(--text-secondary);
				font-weight: 600;
			}

			.client-desc {
				font-size: 0.9rem;
				line-height: 1.6;
				color: var(--text-secondary);
				margin: 0;
			}

			.client-footer {
				margin-top: auto;
				display: flex;
				flex-direction: column;
				gap: 0.85rem;
				padding-top: 1rem;
				border-top: 1px solid var(--border-subtle);
			}

			.protocol-hint {
				font-size: 0.76rem;
				color: var(--text-muted);
			}

			.client-links {
				display: flex;
				gap: 0.5rem;
			}

			.client-links a {
				flex: 1;
			}

			/* FAQ Section */
			.faq-list {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.faq-item {
				border: 1px solid var(--border-subtle);
			}

			.faq-summary {
				padding: 1.35rem 1.6rem;
				font-weight: 700;
				font-size: 1.05rem;
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: space-between;
				list-style: none;
				user-select: none;
			}

			.faq-summary::-webkit-details-marker {
				display: none;
			}

			.faq-chevron {
				transition: transform 0.2s ease;
				color: #38bdf8;
				display: flex;
				align-items: center;
			}

			.faq-item[open] .faq-chevron {
				transform: rotate(180deg);
			}

			.faq-content {
				padding: 0 1.6rem 1.4rem;
				color: var(--text-secondary);
				font-size: 0.98rem;
				line-height: 1.75;
			}

			.faq-content p {
				margin: 0;
			}

			@media (max-width: 768px) {
				.section-header {
					flex-direction: column;
					align-items: flex-start;
				}
				.hero-title {
					font-size: 2.2rem;
				}
				.hero-actions {
					flex-direction: column;
					width: 100%;
				}
				.hero-actions a, .hero-actions button {
					width: 100%;
				}
			}
		</style>

		<script>
			const tabs = document.querySelectorAll('#airportFilterTabs .filter-tab');
			const cards = document.querySelectorAll('#airportsList .airport-card');

			tabs.forEach(tab => {
				tab.addEventListener('click', () => {
					tabs.forEach(t => t.classList.remove('active'));
					tab.classList.add('active');

					const filter = tab.getAttribute('data-filter');
					cards.forEach(card => {
						const cat = card.getAttribute('data-category');
						if (filter === 'all' || cat === filter) {
							(card as HTMLElement).style.display = 'flex';
						} else {
							(card as HTMLElement).style.display = 'none';
						}
					});
				});
			});
		</script>
	</body>
</html>

---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SearchModal from '../components/SearchModal.astro';
import { POPULAR_CLIENTS, SITE_TITLE } from '../consts';

const platformsList = ['全部', 'iOS', 'Windows', 'Android', 'macOS', 'Linux'];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead 
			title={`全平台科学上网客户端下载与配置中心 | ${SITE_TITLE}`} 
			description="提供 iOS (小火箭/Nextin/Surge/Loon/圈X)、Windows (v2rayN/Clash Verge Rev/Mihomo Party)、Android (v2rayNG/FlClash) 等官方正版下载渠道与配置指南。" 
		/>
	</head>
	<body>
		<Header />

		<main class="clients-main">
			<div class="container">
				<!-- Header Section -->
				<div class="page-header">
					<nav class="breadcrumbs">
						<a href="/">首页</a>
						<span class="sep">/</span>
						<span class="current">客户端中心</span>
					</nav>

					<span class="badge badge-emerald">OFFICIAL CLIENT DOWNLOADS</span>
					<h1 class="page-title">全平台科学上网客户端一站式配置</h1>
					<p class="page-lead">
						工欲善其事，必先利其器。我们整理了各大操作系统下经过全球开源社区与发烧友深度检验的现代主流客户端，涵盖 iOS 小火箭 (Shadowrocket)、Windows v2rayN、Android v2rayNG、桌面级 Clash Verge Rev、Mihomo Party 以及新一代 Sing-box 内核，提供安全官方下载通道，拒绝任何自带广告与后门的第三方野鸡定制版。
					</p>
				</div>

				<!-- Platform Filter Bar -->
				<div class="platform-filter-bar">
					<span class="filter-label">平台快速筛选：</span>
					<div class="filter-btns" id="platformFilterBtns">
						{platformsList.map((platform, idx) => (
							<button 
								type="button" 
								class:list={['filter-btn', { active: idx === 0 }]} 
								data-platform={platform}
							>
								{platform}
							</button>
						))}
					</div>
				</div>

				<!-- Clients Grid -->
				<div class="clients-grid" id="clientsGrid">
					{POPULAR_CLIENTS.map((client) => (
						<div 
							class="client-detail-card glass-panel" 
							data-platforms={JSON.stringify(client.platforms)}
						>
							<div class="card-head">
								<div class="head-info">
									<h2 class="client-name">{client.name}</h2>
									<span class="client-cat-tag">{client.category}</span>
								</div>
								{client.badge && <span class="badge badge-amber">{client.badge}</span>}
							</div>

							<div class="platforms-row">
								<span class="platform-label">适配系统：</span>
								<div class="platform-badges">
									{client.platforms.map((p) => (
										<span class="platform-pill">{p}</span>
									))}
								</div>
							</div>

							<p class="client-description">{client.description}</p>

							<div class="protocols-box">
								<span class="proto-label">推荐协议：</span>
								<span class="proto-val">{client.recommendedProtocol}</span>
							</div>

							<div class="card-actions">
								<a href={`/blog/${client.tutorialSlug}/`} class="btn btn-secondary">
									查阅配置教程
								</a>
								<a href={client.downloadUrl} target="_blank" rel="noopener noreferrer nofollow" class="btn btn-primary">
									官方下载 ➔
								</a>
							</div>
						</div>
					))}
				</div>

				<!-- Safety Warning Box -->
				<section class="safety-box glass-panel">
					<h3>客户端下载安全守则（重要安全警示）</h3>
					<div class="safety-tips-grid">
						<div class="safety-tip">
							<strong>1. 远离搜索推广与山寨网页</strong>
							<p>许多搜索引擎前几个结果常被山寨仿冒钓鱼网站买下广告位，下载的文件常被二次植入木马病毒或勒索后门，请认准官方 GitHub Releases 或官方商店。</p>
						</div>
						<div class="safety-tip">
							<strong>2. 拒绝使用“某某机场专属定制客户端”</strong>
							<p>一些小型跑路机场诱导用户下载其深度二次打包的一键包，往往存在强制弹窗、劫持首页、甚至明文抓取账号密码与财务凭证的极高风险。</p>
						</div>
						<div class="safety-tip">
							<strong>3. iOS 请认准外区正版 App Store</strong>
							<p>Shadowrocket（小火箭）、Surge、Loon、Quantumult X 等属于海外 App Store 付费应用，请注册正规外区 Apple ID 购买，切忌在来历不明的网站绑定个人 Apple 设备。</p>
						</div>
					</div>
				</section>
			</div>
		</main>

		<Footer />
		<SearchModal />

		<script>
			const filterBtns = document.querySelectorAll('#platformFilterBtns .filter-btn');
			const cards = document.querySelectorAll('#clientsGrid .client-detail-card');

			filterBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					filterBtns.forEach(b => b.classList.remove('active'));
					btn.classList.add('active');

					const targetPlatform = btn.getAttribute('data-platform') || '全部';

					cards.forEach(card => {
						const platforms = JSON.parse(card.getAttribute('data-platforms') || '[]');
						if (targetPlatform === '全部' || platforms.includes(targetPlatform)) {
							(card as HTMLElement).style.display = 'flex';
						} else {
							(card as HTMLElement).style.display = 'none';
						}
					});
				});
			});
		</script>

		<style>
			.clients-main {
				padding: 3rem 0 6rem;
			}

			.page-header {
				max-width: 860px;
				margin-bottom: 2.5rem;
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
			}

			.breadcrumbs {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.85rem;
				color: var(--text-muted);
			}

			.breadcrumbs a {
				color: var(--text-muted);
			}

			.breadcrumbs a:hover {
				color: var(--accent-light);
			}

			.breadcrumbs .current {
				color: var(--text-secondary);
			}

			.page-title {
				font-size: clamp(2.2rem, 4.5vw, 3.2rem);
				font-weight: 900;
				margin: 0;
			}

			.page-lead {
				font-size: 1.15rem;
				color: var(--text-secondary);
				line-height: 1.75;
				margin: 0;
			}

			/* Platform Filter Bar */
			.platform-filter-bar {
				display: flex;
				align-items: center;
				gap: 1rem;
				margin-bottom: 2.5rem;
				padding: 0.75rem 1.25rem;
				background: var(--bg-card);
				border: 1px solid var(--border-subtle);
				flex-wrap: wrap;
			}

			.filter-label {
				font-size: 0.88rem;
				font-weight: 700;
				color: var(--text-muted);
			}

			.filter-btns {
				display: flex;
				gap: 0.5rem;
				flex-wrap: wrap;
			}

			.filter-btn {
				background: transparent;
				border: 1px solid var(--border-subtle);
				color: var(--text-secondary);
				padding: 0.4rem 0.9rem;
				font-size: 0.86rem;
				font-weight: 600;
				cursor: pointer;
				transition: all 0.15s ease;
			}

			.filter-btn:hover {
				color: var(--text-primary);
				border-color: var(--border-strong);
				background: var(--bg-card-hover);
			}

			.filter-btn.active {
				background: var(--text-primary);
				color: var(--bg-primary);
				border-color: var(--text-primary);
				font-weight: 700;
			}

			.clients-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
				gap: 2rem;
				margin-bottom: 4rem;
			}

			.client-detail-card {
				padding: 2rem;
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
				border: 1px solid var(--border-subtle);
				background: var(--bg-card);
			}

			.card-head {
				display: flex;
				align-items: flex-start;
				justify-content: space-between;
				gap: 1rem;
			}

			.client-name {
				margin: 0 0 0.35rem 0;
				font-size: 1.35rem;
				font-weight: 800;
				color: var(--text-primary);
			}

			.client-cat-tag {
				font-size: 0.8rem;
				color: var(--accent-cyan);
				font-weight: 700;
			}

			.platforms-row {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.85rem;
			}

			.platform-label {
				color: var(--text-muted);
				font-weight: 600;
			}

			.platform-badges {
				display: flex;
				gap: 0.35rem;
				flex-wrap: wrap;
			}

			.platform-pill {
				background: var(--bg-secondary);
				border: 1px solid var(--border-subtle);
				padding: 0.2rem 0.55rem;
				font-size: 0.76rem;
				color: var(--text-primary);
				font-weight: 600;
			}

			.client-description {
				font-size: 0.95rem;
				line-height: 1.65;
				color: var(--text-secondary);
				margin: 0;
			}

			.protocols-box {
				padding: 0.85rem 1.1rem;
				background: var(--bg-secondary);
				border: 1px solid var(--border-subtle);
				font-size: 0.86rem;
				display: flex;
				align-items: center;
				gap: 0.5rem;
				flex-wrap: wrap;
			}

			.proto-label {
				color: #38bdf8;
				font-weight: 700;
			}

			.proto-val {
				color: var(--text-primary);
			}

			.card-actions {
				margin-top: auto;
				display: flex;
				gap: 0.75rem;
				padding-top: 1.25rem;
				border-top: 1px solid var(--border-subtle);
			}

			.card-actions a {
				flex: 1;
			}

			.safety-box {
				padding: 2.5rem;
				border: 1px solid rgba(245, 158, 11, 0.4);
				background: rgba(245, 158, 11, 0.05);
			}

			.safety-box h3 {
				margin-top: 0;
				margin-bottom: 1.5rem;
				color: #fbbf24;
				font-size: 1.35rem;
				font-weight: 800;
			}

			.safety-tips-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 1.75rem;
			}

			.safety-tip strong {
				display: block;
				margin-bottom: 0.5rem;
				color: var(--text-primary);
			}

			.safety-tip p {
				margin: 0;
				font-size: 0.92rem;
				line-height: 1.7;
				color: var(--text-secondary);
			}

			@media (max-width: 640px) {
				.clients-grid {
					grid-template-columns: 1fr;
				}
				.card-actions {
					flex-direction: column;
				}
				.platform-filter-bar {
					flex-direction: column;
					align-items: flex-start;
				}
			}
		</style>
	</body>
</html>

---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SearchModal from '../components/SearchModal.astro';
import { SITE_NAME, SITE_TITLE } from '../consts';

const TOOLS = [
  {
    title: 'IP 纯净度与欺诈分检测 (Scamalytics)',
    category: 'IP属性分析',
    badge: 'ChatGPT防封必查',
    desc: '检测当前节点的出口 IP 属于机房托管（Hosting）还是真实住宅（ISP），以及 0~100 的欺诈分值。欺诈分越低，越不容易触发 Cloudflare 盾或 AI 封号。',
    url: 'https://scamalytics.com/ip',
    tag: '免费在线'
  },
  {
    title: 'DNS 泄露隐患排查 (DNSLeakTest)',
    category: '隐私安全',
    badge: '隐私体检',
    desc: '一键测试你在开启代理时，DNS 请求是否依旧被国内电信/联通/移动宽带拦截解析。如果测试结果中出现国内运营商，说明存在 DNS 泄露风险。',
    url: 'https://www.dnsleaktest.com/',
    tag: '安全必备'
  },
  {
    title: 'WebRTC 真实 IP 暴露检测 (BrowserLeaks)',
    category: '底层泄漏排查',
    badge: '高危漏洞排查',
    desc: '部分浏览器默认开启 WebRTC 协议，即便挂了代理，网页也能通过 STUN 穿透读取到你本地的真实公网 IP。',
    url: 'https://browserleaks.com/webrtc',
    tag: '极客检测'
  },
  {
    title: 'Speedtest 国际节点测速 (Ookla)',
    category: '带宽性能测试',
    badge: '权威测速',
    desc: '全球权威的下行、上行及延迟抖动测试平台。建议手动将测速目标服务器更改为香港（HKIX）、日本东京（NTT/Softbank）等目标地节点。',
    url: 'https://www.speedtest.net/',
    tag: '带宽验证'
  },
  {
    title: 'YouTube 详细统计信息压测',
    category: '流媒体实际压测',
    badge: '真实体验指标',
    desc: '在 YouTube 4K 视频右键开启「详细统计信息」，观察 Connection Speed。若稳定在 150,000 Kbps 以上且 Buffer Health 保持在 30 秒以上，则为丝滑体验。',
    url: 'https://www.youtube.com/',
    tag: '码率实测'
  },
  {
    title: 'Subconverter 订阅转换安全防范',
    category: '工具使用安全',
    badge: '安全警示',
    desc: '在线公共订阅转换网站能直接截获你的节点链接和机场 Token！若需将各协议转换为 Clash/Sing-box 配置，建议在本地 Docker 自建后端或使用客户端自带转换。',
    url: '/blog/avoid-airport-scams-guide/',
    tag: '防偷节点'
  }
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead 
			title={`实用网络测速与节点检测工具箱 | ${SITE_TITLE}`} 
			description="整理科学上网必知的 IP 纯净度检测、DNS/WebRTC 泄露排查、流媒体解锁测试与订阅转换安全工具指南。" 
		/>
	</head>
	<body>
		<Header />

		<main class="tools-main">
			<div class="container">
				<!-- Header Section -->
				<div class="page-header">
					<nav class="breadcrumbs">
						<a href="/">首页</a>
						<span class="sep">/</span>
						<span class="current">网络工具箱</span>
					</nav>

					<span class="badge badge-cyan">DIAGNOSTIC UTILITIES</span>
					<h1 class="page-title">实用网络测速与节点检测工具箱</h1>
					<p class="page-lead">
						测速不仅仅是看 Speedtest 跑多快。通过以下专业检测工具，你可以精准检测节点是否具备住宅双 ISP 原生属性、排查 DNS/WebRTC 真实 IP 泄露，全面掌握网络状态。
					</p>
				</div>

				<!-- Tools Grid -->
				<div class="tools-grid">
					{TOOLS.map((t) => (
						<div class="tool-card glass-panel">
							<div class="tool-head">
								<span class="badge badge-brand">{t.category}</span>
								<span class="badge badge-amber">{t.badge}</span>
							</div>

							<h2 class="tool-title">{t.title}</h2>

							<p class="tool-desc">{t.desc}</p>

							<div class="tool-footer">
								<span class="tool-tag">{t.tag}</span>
								<a href={t.url} target="_blank" rel="noopener noreferrer nofollow" class="btn btn-primary btn-sm">
									前往测试 ➔
								</a>
							</div>
						</div>
					))}
				</div>

				<!-- Tutorial Guide Highlight -->
				<section class="tools-guide-box glass-panel">
					<h3>测速与日常使用核心避坑技巧</h3>
					<div class="guide-grid">
						<div class="guide-item">
							<h4>Q: 为什么明明节点测速跑了 500M，看 YouTube 却还是卡？</h4>
							<p>测速通常是多线程短时间并发爆发，而流媒体视频是单线程长连接持续吞吐。如果机房丢包严重或出口被限速，单线程速率会断崖式下滑。选购时应认准有 <strong>IEPL 物理专线</strong> 的服务商。</p>
						</div>
						<div class="guide-item">
							<h4>Q: 如何杜绝 WebRTC 和 DNS 泄露？</h4>
							<p>在 Clash Verge Rev 中开启 <strong>TUN 模式</strong> 并开启 <strong>内置 DNS（Fake-IP 或 Redir-Host）</strong>，能让整机的所有 DNS 解析全部交由代理内核完成，彻底根除运营商 DNS 泄露。</p>
						</div>
					</div>
				</section>
			</div>
		</main>

		<Footer />
		<SearchModal />

		<style>
			.tools-main {
				padding: 3rem 0 6rem;
			}

			.page-header {
				max-width: 800px;
				margin-bottom: 3rem;
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
			}

			.breadcrumbs {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.85rem;
				color: var(--text-muted);
			}

			.breadcrumbs a {
				color: var(--text-muted);
			}

			.breadcrumbs a:hover {
				color: var(--accent-light);
			}

			.breadcrumbs .current {
				color: var(--text-secondary);
			}

			.page-title {
				font-size: clamp(2.2rem, 4.5vw, 3.2rem);
				font-weight: 900;
				margin: 0;
			}

			.page-lead {
				font-size: 1.15rem;
				color: var(--text-secondary);
				line-height: 1.75;
				margin: 0;
			}

			.tools-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
				gap: 2rem;
				margin-bottom: 4rem;
			}

			.tool-card {
				padding: 2rem;
				display: flex;
				flex-direction: column;
				gap: 1rem;
				border: 1px solid var(--border-subtle);
			}

			.tool-head {
				display: flex;
				align-items: center;
				justify-content: space-between;
			}

			.tool-title {
				margin: 0;
				font-size: 1.25rem;
				font-weight: 800;
				color: var(--text-primary);
			}

			.tool-desc {
				font-size: 0.92rem;
				color: var(--text-secondary);
				line-height: 1.65;
				margin: 0;
			}

			.tool-footer {
				margin-top: auto;
				padding-top: 1.25rem;
				border-top: 1px solid var(--border-subtle);
				display: flex;
				align-items: center;
				justify-content: space-between;
			}

			.tool-tag {
				font-size: 0.82rem;
				color: var(--accent-cyan);
				font-weight: 700;
			}

			.tools-guide-box {
				padding: 2.5rem;
				border: 1px solid var(--border-subtle);
			}

			.tools-guide-box h3 {
				margin-top: 0;
				margin-bottom: 1.5rem;
				font-size: 1.4rem;
				font-weight: 800;
			}

			.guide-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
				gap: 2rem;
			}

			.guide-item h4 {
				margin: 0 0 0.5rem 0;
				font-size: 1.1rem;
				color: #60a5fa;
				font-weight: 700;
			}

			.guide-item p {
				margin: 0;
				font-size: 0.94rem;
				line-height: 1.7;
				color: var(--text-secondary);
			}

			@media (max-width: 640px) {
				.tools-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</body>
</html>

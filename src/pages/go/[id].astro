---
import { TOP_AIRPORTS } from '../../consts';

export function getStaticPaths() {
	return TOP_AIRPORTS.map((airport) => ({
		params: { id: airport.id },
		props: { airport },
	}));
}

const { airport } = Astro.props;
const targetUrl = airport.affUrl;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>正在安全跳转至 {airport.name} 官方网站 - 机场搜 (Jichangs.org)</title>
		
		<!-- SEO & Meta Name Directives -->
		<meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
		<meta name="googlebot" content="noindex, nofollow" />
		<meta name="bingbot" content="noindex, nofollow" />
		<meta name="referrer" content="no-referrer" />
		
		<!-- 302 Meta Refresh Redirect -->
		<meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
		<link rel="canonical" href={`https://jichangs.org/go/${airport.id}`} />

		<script define:vars={{ targetUrl }}>
			if (typeof window !== 'undefined' && targetUrl && targetUrl !== '#') {
				window.location.replace(targetUrl);
			}
		</script>

		<style>
			:root {
				--bg-dark: #090d16;
				--card-bg: #111726;
				--border-color: #1e293b;
				--accent-cyan: #00d2ff;
				--text-main: #f1f5f9;
				--text-muted: #94a3b8;
			}
			* {
				box-sizing: border-box;
				border-radius: 0 !important;
			}
			body {
				margin: 0;
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				background-color: var(--bg-dark);
				color: var(--text-main);
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
				padding: 1.5rem;
			}
			.redirect-container {
				width: 100%;
				max-width: 440px;
				background: var(--card-bg);
				border: 1px solid var(--border-color);
				padding: 2.5rem 2rem;
				text-align: center;
				box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
			}
			.site-badge {
				display: inline-block;
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--accent-cyan);
				background: rgba(0, 210, 255, 0.1);
				border: 1px solid rgba(0, 210, 255, 0.25);
				padding: 0.25rem 0.75rem;
				margin-bottom: 1.25rem;
			}
			.redirect-title {
				font-size: 1.25rem;
				font-weight: 700;
				margin: 0 0 0.75rem 0;
				color: var(--text-main);
			}
			.redirect-desc {
				font-size: 0.875rem;
				color: var(--text-muted);
				line-height: 1.6;
				margin: 0 0 1.75rem 0;
			}
			.spinner {
				width: 36px;
				height: 36px;
				border: 3px solid rgba(255, 255, 255, 0.1);
				border-top-color: var(--accent-cyan);
				animation: spin 0.8s linear infinite;
				margin: 0 auto 1.75rem auto;
			}
			@keyframes spin {
				to { transform: rotate(360deg); }
			}
			.manual-btn {
				display: inline-block;
				width: 100%;
				background: var(--accent-cyan);
				color: #000;
				font-weight: 700;
				font-size: 0.9375rem;
				padding: 0.875rem 1.25rem;
				text-decoration: none;
				transition: opacity 0.2s ease;
			}
			.manual-btn:hover {
				opacity: 0.9;
			}
			.footer-hint {
				margin-top: 1.25rem;
				font-size: 0.75rem;
				color: #64748b;
			}
		</style>
	</head>
	<body>
		<div class="redirect-container">
			<span class="site-badge">Jichangs.org · 安全重定向</span>
			<h1 class="redirect-title">正在前往 {airport.name} 官方网站</h1>
			<p class="redirect-desc">
				正在为你接入已核验的官方站点并载入专属优惠礼遇，系统将在 1 秒内自动完成 302 重定向...
			</p>

			<div class="spinner"></div>

			<a 
				href={targetUrl} 
				rel="nofollow noopener noreferrer" 
				class="manual-btn"
			>
				若未自动跳转，点击立即前往 ➔
			</a>

			<div class="footer-hint">
				经机场搜 (Jichangs.org) 独立安全校验 · 无死链保障
			</div>
		</div>
	</body>
</html>

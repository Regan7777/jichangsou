---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import AirportCard from '../components/AirportCard.astro';
import SearchModal from '../components/SearchModal.astro';
import { SITE_NAME, SITE_TITLE, TOP_AIRPORTS } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead 
			title={`2026优质高速机场天梯榜与多维横评矩阵 | ${SITE_TITLE}`} 
			description="汇总2026年最新晚高峰测速跑分、IEPL内网专线稳定性、流媒体/ChatGPT原生解锁度与价格对比，拒绝虚标跑路云。" 
		/>
	</head>
	<body>
		<Header />

		<main class="ranking-main">
			<div class="container">
				<!-- Header Section -->
				<div class="ranking-header">
					<nav class="breadcrumbs">
						<a href="/">首页</a>
						<span class="sep">/</span>
						<span class="current">2026 天梯排行榜</span>
					</nav>

					<span class="badge badge-amber">COMPREHENSIVE LEADERBOARD</span>
					<h1 class="page-title">2026 优质稳定机场天梯排行榜</h1>
					<p class="page-lead">
						本榜单每月基于真实双线物理千兆宽带、在晚高峰 20:00~23:00 黄金拥堵时段进行连续高压测速，综合晚高峰速率、丢包抖动、流媒体/AI 解锁能力、退款承诺及售后客服响应实测排定。
					</p>

					<!-- Legend pills -->
					<div class="legend-bar">
						<span class="legend-item"><span class="dot dot-green"></span> 晚高峰零丢包</span>
						<span class="legend-item"><span class="dot dot-cyan"></span> 原生住宅 IP 解锁</span>
						<span class="legend-item"><span class="dot dot-amber"></span> 专属折扣立减</span>
					</div>
				</div>

				<!-- Comparison Table Matrix -->
				<section class="table-section">
					<div class="section-title-row">
						<h2>核心参数横向对比矩阵</h2>
					</div>

					<div class="table-responsive glass-panel">
						<table class="ranking-table">
							<thead>
								<tr>
									<th class="th-rank">排名</th>
									<th class="th-name">机场服务商</th>
									<th class="th-type">线路架构</th>
									<th class="th-unlock">流媒体 / AI 解锁</th>
									<th class="th-proto">协议支持</th>
									<th class="th-price">起步参考</th>
									<th class="th-coupon">专属优惠码</th>
									<th class="th-action">操作</th>
								</tr>
							</thead>
							<tbody>
								{TOP_AIRPORTS.map((item, idx) => (
									<tr>
										<td class="td-rank" data-label="排名">
											<span class:list={['rank-badge-tbl', { 'top-3': idx < 3 }]}>
												{String(idx + 1).padStart(2, '0')}
											</span>
										</td>
										<td class="td-name" data-label="机场服务商">
											<div class="tbl-name-cell">
												<strong>{item.name}</strong>
												<span class="tbl-tagline">{item.tagline}</span>
											</div>
										</td>
										<td class="td-type" data-label="线路架构">
											<span class="tbl-pill">{item.type}</span>
										</td>
										<td class="td-unlock" data-label="流媒体/AI">
											<span class="tbl-unlock">{item.streamingUnlock.slice(0, 3).join(', ')} 全解锁</span>
										</td>
										<td class="td-proto" data-label="协议支持">
											<span class="tbl-protocols">{item.protocols.join(' / ')}</span>
										</td>
										<td class="td-price" data-label="起步参考">
											<strong class="tbl-price">{item.startingPrice}</strong>
											<span class="tbl-period">/{item.billingPeriod}</span>
										</td>
										<td class="td-coupon" data-label="优惠码">
											<button 
												type="button" 
												class="coupon-tag"
												onclick={`copyText('${item.promoCode}', '优惠码 ${item.promoCode} 已复制，享${item.discount}！')`}
												title="点击复制优惠码"
											>
												<code>{item.promoCode}</code>
											</button>
										</td>
										<td class="td-action" data-label="直达">
											<div class="tbl-actions">
												<a href={`/go/${item.id}`} target="_blank" rel="noopener noreferrer nofollow sponsored" class="btn btn-primary btn-sm">官网 ➔</a>
											</div>
										</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</section>

				<!-- Detailed Cards View -->
				<section class="cards-section">
					<h2 class="section-heading">详细评测与节点特性详解</h2>
					<div class="cards-column">
						{TOP_AIRPORTS.map((item, idx) => (
							<AirportCard airport={item} rank={idx + 1} />
						))}
					</div>
				</section>

				<!-- Evaluation Standards Explanation -->
				<section class="methodology-section glass-panel">
					<h3>机场搜的实测评估标准</h3>
					<div class="methodology-grid">
						<div class="method-card">
							<h4>1. 晚高峰 20:00~23:00 压力实测</h4>
							<p>非高峰期的测速毫无参考价值。我们所有数据均采集自全网国际出口最拥堵的晚间时段，并利用 4K/8K 视频连续播放 2 小时统计缓冲停顿频次。</p>
						</div>
						<div class="method-card">
							<h4>2. 住宅双 ISP 原生 IP 验证</h4>
							<p>通过专有探针检测节点的 ASN 属性与 IP 纯净度（Fraud Score），确保能够顺畅访问 ChatGPT 4o、Claude 3.5 及非自制剧 Netflix。</p>
						</div>
						<div class="method-card">
							<h4>3. 真实工单与售后响应度</h4>
							<p>测试客服工单在故障断连时的响应时效，排除那些节点出故障几天无人维护的兼职私人小作坊。</p>
						</div>
					</div>
				</section>
			</div>
		</main>

		<Footer />
		<SearchModal />

		<style>
			.ranking-main {
				padding: 3rem 0 6rem;
			}

			.ranking-header {
				max-width: 850px;
				margin-bottom: 3rem;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.breadcrumbs {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.85rem;
				color: var(--text-muted);
			}

			.breadcrumbs a {
				color: var(--text-muted);
			}

			.breadcrumbs a:hover {
				color: var(--accent-light);
			}

			.breadcrumbs .current {
				color: var(--text-secondary);
			}

			.page-title {
				font-size: clamp(2.2rem, 4.5vw, 3.2rem);
				font-weight: 900;
				margin: 0;
			}

			.page-lead {
				font-size: 1.15rem;
				color: var(--text-secondary);
				line-height: 1.75;
				margin: 0;
			}

			.legend-bar {
				display: flex;
				gap: 1.5rem;
				flex-wrap: wrap;
				margin-top: 0.5rem;
			}

			.legend-item {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				font-size: 0.85rem;
				color: var(--text-secondary);
				font-weight: 600;
			}

			.dot {
				width: 8px;
				height: 8px;
			}

			.dot-green { background: #10b981; }
			.dot-cyan { background: #06b6d4; }
			.dot-amber { background: #f59e0b; }

			.table-section {
				margin-bottom: 4rem;
			}

			.section-title-row {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				margin-bottom: 1.25rem;
				flex-wrap: wrap;
				gap: 0.5rem;
			}

			.section-title-row h2 {
				margin: 0;
				font-size: 1.5rem;
				font-weight: 800;
			}

			.table-hint {
				font-size: 0.82rem;
				color: var(--text-muted);
			}

			.table-responsive {
				width: 100%;
				overflow-x: auto;
			}

			.ranking-table {
				width: 100%;
				border-collapse: collapse;
				text-align: left;
				font-size: 0.9rem;
			}

			.ranking-table th, .ranking-table td {
				padding: 0.85rem 1rem;
				border: 1px solid var(--border-subtle);
				vertical-align: middle;
			}

			.ranking-table th {
				background: var(--bg-secondary);
				color: var(--text-primary);
				font-weight: 700;
				font-size: 0.85rem;
				letter-spacing: 0.04em;
				border-bottom: 2px solid var(--border-strong);
			}

			:global([data-theme="light"]) .ranking-table th {
				background: #f1f5f9;
				color: #0f172a;
				border-color: #cbd5e1;
			}

			.ranking-table tr:hover td {
				background: var(--bg-card-hover);
			}

			.th-rank, .td-rank { width: 56px; text-align: center; }
			.th-name, .td-name { width: 24%; }
			.th-type, .td-type { width: 14%; }
			.th-unlock, .td-unlock { width: 22%; }
			.th-proto, .td-proto { width: 14%; }
			.th-price, .td-price { width: 12%; }
			.th-coupon, .td-coupon { width: 14%; }
			.th-action, .td-action { width: 90px; text-align: center; }

			.rank-badge-tbl {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 30px;
				height: 30px;
				background: var(--bg-secondary);
				border: 1px solid var(--border-strong);
				font-weight: 900;
				font-family: var(--font-mono);
				color: var(--text-muted);
			}

			.rank-badge-tbl.top-3 {
				background: var(--text-primary);
				color: var(--bg-primary);
				border-color: var(--text-primary);
			}

			.tbl-name-cell {
				display: flex;
				flex-direction: column;
				gap: 0.2rem;
			}

			.tbl-name-cell strong {
				color: var(--text-primary);
				font-size: 0.98rem;
				font-weight: 800;
			}

			.tbl-tagline {
				font-size: 0.78rem;
				color: var(--text-muted);
				line-height: 1.4;
			}

			.tbl-pill {
				font-size: 0.74rem;
				padding: 0.2rem 0.45rem;
				background: rgba(6, 182, 212, 0.12);
				color: #0891b2;
				border: 1px solid rgba(6, 182, 212, 0.3);
				font-weight: 700;
				display: inline-block;
			}

			:global([data-theme="dark"]) .tbl-pill, html:not([data-theme="light"]) .tbl-pill {
				color: #22d3ee;
			}

			.tbl-unlock {
				color: #059669;
				font-size: 0.84rem;
				font-weight: 600;
			}

			:global([data-theme="dark"]) .tbl-unlock, html:not([data-theme="light"]) .tbl-unlock {
				color: #34d399;
			}

			.tbl-protocols {
				font-size: 0.82rem;
				color: var(--text-secondary);
			}

			.tbl-price {
				font-size: 1.15rem;
				color: #d97706;
				font-weight: 900;
			}

			:global([data-theme="dark"]) .tbl-price, html:not([data-theme="light"]) .tbl-price {
				color: #fbbf24;
			}

			.tbl-period {
				font-size: 0.75rem;
				color: var(--text-muted);
			}

			.tbl-actions {
				display: flex;
				justify-content: center;
			}

			/* Mobile Responsive Layout: Eliminate horizontal scroll, make it natural card rows */
			@media (max-width: 860px) {
				.table-responsive {
					overflow-x: visible;
				}
				.ranking-table, .ranking-table thead, .ranking-table tbody, .ranking-table tr, .ranking-table td {
					display: block;
					width: 100%;
				}
				.ranking-table thead {
					display: none;
				}
				.ranking-table tr {
					margin-bottom: 1.25rem;
					background: var(--bg-card);
					border: 1px solid var(--border-subtle);
					padding: 1.25rem;
				}
				.ranking-table td {
					padding: 0.5rem 0;
					border: none;
					display: flex;
					justify-content: space-between;
					align-items: center;
					text-align: right;
					width: 100% !important;
				}
				.ranking-table td::before {
					content: attr(data-label);
					font-weight: 700;
					font-size: 0.82rem;
					color: var(--text-muted);
					text-transform: uppercase;
					text-align: left;
					flex-shrink: 0;
				}
				.ranking-table td.td-rank {
					justify-content: flex-start;
					gap: 0.75rem;
					padding-bottom: 0.75rem;
					border-bottom: 1px solid var(--border-subtle);
					margin-bottom: 0.5rem;
				}
				.ranking-table td.td-name {
					flex-direction: column;
					align-items: flex-start;
					gap: 0.25rem;
					text-align: left;
					padding-bottom: 0.75rem;
					border-bottom: 1px solid var(--border-subtle);
					margin-bottom: 0.5rem;
				}
				.ranking-table td.td-name::before {
					display: none;
				}
				.ranking-table td.td-action {
					padding-top: 0.75rem;
					border-top: 1px solid var(--border-subtle);
					margin-top: 0.5rem;
				}
				.ranking-table td.td-action a {
					width: 100%;
					justify-content: center;
				}
			}

			.cards-section {
				margin-bottom: 4rem;
			}

			.section-heading {
				margin-bottom: 1.5rem;
				font-size: 1.5rem;
				font-weight: 800;
			}

			.cards-column {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}

			.methodology-section {
				padding: 2.5rem;
			}

			.methodology-section h3 {
				margin-top: 0;
				margin-bottom: 1.5rem;
				font-size: 1.4rem;
				font-weight: 800;
			}

			.methodology-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 1.75rem;
			}

			.method-card h4 {
				margin-top: 0;
				margin-bottom: 0.5rem;
				font-size: 1.1rem;
				color: #60a5fa;
				font-weight: 700;
			}

			.method-card p {
				margin: 0;
				font-size: 0.92rem;
				line-height: 1.7;
				color: var(--text-secondary);
			}
		</style>
	</body>
</html>

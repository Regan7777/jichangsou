---
import HeaderLink from './HeaderLink.astro';
import { SITE_NAME } from '../consts';
---

<header class="site-header">
	<div class="container header-container">
		<a href="/" class="brand-logo" aria-label="机场搜 首页">
			<div class="logo-icon">
				<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" stroke-linejoin="miter">
					<path d="M22 2L11 13"></path>
					<path d="M22 2L15 22L11 13L2 9L22 2Z"></path>
				</svg>
			</div>
			<div class="brand-text">
				<span class="brand-name">{SITE_NAME}<span class="brand-tld">.org</span></span>
				<span class="brand-sub">JICHANGS.ORG</span>
			</div>
		</a>

		<nav class="desktop-nav" aria-label="主导航">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/ranking">天梯榜</HeaderLink>
			<HeaderLink href="/blog">评测文章</HeaderLink>
			<HeaderLink href="/clients">客户端指南</HeaderLink>
			<HeaderLink href="/tools">网络工具</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</nav>

		<div class="header-actions">
			<!-- High-Contrast Sharp Quick Search Trigger -->
			<button type="button" class="search-trigger-btn" id="openSearchBtn" aria-label="搜索全站文章与节点">
				<svg class="search-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2">
					<circle cx="11" cy="11" r="7"></circle>
					<line x1="21" y1="21" x2="16" y2="16"></line>
				</svg>
				<span class="search-text">搜索文章 / 节点...</span>
				<kbd class="search-kbd">⌘K</kbd>
			</button>

			<!-- Theme Toggle Button -->
			<button type="button" class="theme-toggle-btn" id="themeToggleBtn" aria-label="切换深色/浅色主题">
				<svg class="sun-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
					<circle cx="12" cy="12" r="4"></circle>
					<line x1="12" y1="2" x2="12" y2="5"></line>
					<line x1="12" y1="19" x2="12" y2="22"></line>
					<line x1="2" y1="12" x2="5" y2="12"></line>
					<line x1="19" y1="12" x2="22" y2="12"></line>
					<line x1="4.93" y1="4.93" x2="7.05" y2="7.05"></line>
					<line x1="16.95" y1="16.95" x2="19.07" y2="19.07"></line>
					<line x1="4.93" y1="19.07" x2="7.05" y2="16.95"></line>
					<line x1="16.95" y1="7.05" x2="19.07" y2="4.93"></line>
				</svg>
				<svg class="moon-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
				</svg>
			</button>

			<!-- Mobile Menu Toggle -->
			<button type="button" class="mobile-menu-btn" id="mobileMenuBtn" aria-label="打开手机菜单">
				<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
					<line x1="3" y1="12" x2="21" y2="12"></line>
					<line x1="3" y1="6" x2="21" y2="6"></line>
					<line x1="3" y1="18" x2="21" y2="18"></line>
				</svg>
			</button>
		</div>
	</div>

	<!-- Mobile Drawer Menu -->
	<div class="mobile-drawer" id="mobileDrawer">
		<div class="mobile-drawer-inner">
			<nav class="mobile-links">
				<a href="/" class="mobile-link">首页</a>
				<a href="/ranking" class="mobile-link">2026 机场天梯榜</a>
				<a href="/blog" class="mobile-link">深度评测与文章</a>
				<a href="/clients" class="mobile-link">客户端使用指南</a>
				<a href="/tools" class="mobile-link">实用测速工具箱</a>
				<a href="/about" class="mobile-link">关于与实测声明</a>
			</nav>
			<div class="mobile-drawer-footer">
				<button class="btn btn-primary w-full" onclick="document.getElementById('openSearchBtn')?.click()">搜索全站</button>
			</div>
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 1000;
		width: 100%;
		background: var(--bg-glass);
		border-bottom: 1px solid var(--border-subtle);
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}

	.header-container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 64px;
		gap: 1.5rem;
	}

	.brand-logo {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
		flex-shrink: 0;
	}

	.logo-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		background: #2563eb;
		color: #ffffff;
		border: 1px solid #3b82f6;
		box-shadow: 0 0 15px rgba(37, 99, 235, 0.4);
	}

	.brand-text {
		display: flex;
		flex-direction: column;
		line-height: 1.1;
	}

	.brand-name {
		font-weight: 900;
		font-size: 1.3rem;
		color: var(--text-primary);
		letter-spacing: -0.02em;
	}

	.brand-tld {
		color: var(--accent-cyan);
	}

	.brand-sub {
		font-size: 0.68rem;
		color: var(--text-muted);
		font-weight: 700;
		letter-spacing: 0.1em;
	}

	.desktop-nav {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		height: 100%;
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	/* High-Contrast Sharp Search button */
	.search-trigger-btn {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		padding: 0.5rem 1rem;
		background: var(--bg-card);
		border: 1px solid var(--border-subtle);
		color: var(--text-primary);
		font-size: 0.88rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	:global([data-theme="light"]) .search-trigger-btn {
		background: #ffffff;
		border: 1px solid var(--border-subtle);
		color: var(--text-primary);
	}

	.search-trigger-btn:hover {
		border-color: var(--border-strong);
		background: var(--bg-card-hover);
		color: var(--text-primary);
	}

	:global([data-theme="light"]) .search-trigger-btn:hover {
		background: #f1f5f9;
		border-color: var(--border-strong);
	}

	.search-icon {
		color: #38bdf8;
		flex-shrink: 0;
	}

	.search-text {
		color: var(--text-secondary);
	}

	.search-kbd {
		background: rgba(255, 255, 255, 0.1);
		border: 1px solid var(--border-subtle);
		padding: 0.15rem 0.4rem;
		font-size: 0.72rem;
		font-family: var(--font-mono);
		font-weight: 700;
		color: var(--accent-light);
	}

	:global([data-theme="light"]) .search-kbd {
		background: #e2e8f0;
		border-color: #cbd5e1;
		color: var(--text-primary);
	}

	/* Theme Toggle Button */
	.theme-toggle-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		background: var(--bg-card);
		border: 1px solid var(--border-strong);
		color: var(--text-primary);
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.theme-toggle-btn:hover {
		background: var(--bg-card-hover);
		border-color: var(--border-highlight);
	}

	.sun-icon { display: none; }
	.moon-icon { display: block; }

	:global([data-theme="light"]) .sun-icon { display: block; }
	:global([data-theme="light"]) .moon-icon { display: none; }

	/* Mobile Menu Button */
	.mobile-menu-btn {
		display: none;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		background: transparent;
		border: 1px solid var(--border-strong);
		color: var(--text-primary);
		cursor: pointer;
	}

	/* Mobile Drawer */
	.mobile-drawer {
		display: none;
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		background: var(--bg-secondary);
		border-bottom: 1px solid var(--border-strong);
		box-shadow: var(--shadow-lg);
		padding: 1rem 1.5rem 1.5rem;
	}

	.mobile-drawer.is-open {
		display: block;
	}

	.mobile-links {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin-bottom: 1rem;
	}

	.mobile-link {
		padding: 0.75rem 1rem;
		color: var(--text-primary);
		font-weight: 600;
		font-size: 0.95rem;
		text-decoration: none;
		background: var(--bg-card);
		border: 1px solid var(--border-subtle);
	}

	.mobile-link:hover {
		background: rgba(37, 99, 235, 0.15);
		border-color: var(--border-highlight);
	}

	.w-full {
		width: 100%;
	}

	@media (max-width: 900px) {
		.desktop-nav {
			display: none;
		}
		.mobile-menu-btn {
			display: flex;
		}
		.search-text, .search-kbd {
			display: none;
		}
		.search-trigger-btn {
			padding: 0.5rem;
		}
	}
</style>

<script>
	const themeBtn = document.getElementById('themeToggleBtn');
	if (themeBtn) {
		themeBtn.addEventListener('click', () => {
			const isLight = document.documentElement.getAttribute('data-theme') === 'light';
			const newTheme = isLight ? 'dark' : 'light';
			if (newTheme === 'light') {
				document.documentElement.setAttribute('data-theme', 'light');
			} else {
				document.documentElement.removeAttribute('data-theme');
			}
			localStorage.setItem('theme', newTheme);
		});
	}

	const mobileBtn = document.getElementById('mobileMenuBtn');
	const mobileDrawer = document.getElementById('mobileDrawer');
	if (mobileBtn && mobileDrawer) {
		mobileBtn.addEventListener('click', () => {
			mobileDrawer.classList.toggle('is-open');
		});
	}
</script>

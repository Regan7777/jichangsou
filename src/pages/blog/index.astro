---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import SearchModal from '../../components/SearchModal.astro';
import { SITE_NAME, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const categories = ['全部', ...new Set(posts.map(p => p.data.category || '机场评测'))];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead 
			title={`深度评测与配置教程文章列表 | ${SITE_TITLE}`} 
			description="收录2026最新高速机场节点实测、IEPL专线晚高峰跑分、Clash与Sing-box配置指南及防跑路避坑手册。" 
		/>
	</head>
	<body>
		<Header />

		<main class="blog-archive-main">
			<div class="container">
				<!-- Header section -->
				<div class="archive-header">
					<span class="badge badge-cyan">KNOWLEDGE ARCHIVE</span>
					<h1 class="archive-title">全部深度评测与实操教程</h1>
					<p class="archive-desc">
						坚持中立客观实测，拒绝充值洗白。涵盖机场晚高峰跑分、流媒体与ChatGPT原生解锁测试、各平台客户端图文上手指南。
					</p>

					<!-- Search & Filter Controls -->
					<div class="filter-controls-box glass-panel">
						<div class="search-input-wrap">
							<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2">
								<circle cx="11" cy="11" r="7"></circle>
								<line x1="21" y1="21" x2="16" y2="16"></line>
							</svg>
							<input 
								type="text" 
								id="articleSearchInput" 
								placeholder="输入标题关键词或标签（例如：IEPL、TUN、ChatGPT、按量计费）..."
							/>
						</div>

						<div class="category-pills" id="categoryPills">
							{categories.map((cat, idx) => (
								<button 
									type="button" 
									class:list={['cat-pill', { active: idx === 0 }]}
									data-category={cat}
								>
									{cat}
								</button>
							))}
						</div>
					</div>
				</div>

				<!-- Posts Grid -->
				<div class="posts-grid" id="postsGrid">
					{posts.map((post) => (
						<article 
							class="post-item-card glass-panel"
							data-category={post.data.category || '机场评测'}
							data-title={post.data.title.toLowerCase()}
							data-tags={(post.data.tags || []).join(' ').toLowerCase()}
						>
							<a href={`/blog/${post.id}/`} class="card-inner-link">
								<div class="card-top-meta">
									<span class="badge badge-brand">{post.data.category || '深度评测'}</span>
									{post.data.badge && <span class="badge badge-amber">{post.data.badge}</span>}
									<span class="pub-date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</div>

								<h2 class="post-card-title">{post.data.title}</h2>

								<p class="post-card-excerpt">{post.data.description}</p>

								<div class="card-footer-meta">
									<div class="tags-row">
										{(post.data.tags || []).map((tag: string) => (
											<span class="tag-pill">#{tag}</span>
										))}
									</div>
									<span class="read-btn">阅读全文 ➔</span>
								</div>
							</a>
						</article>
					))}
				</div>

				<div class="no-results-msg" id="noResultsMsg" style="display: none;">
					<p>未找到符合条件的评测文章，换个搜索词试试吧！</p>
				</div>
			</div>
		</main>

		<Footer />
		<SearchModal />

		<style>
			.blog-archive-main {
				padding: 3rem 0 6rem;
			}

			.archive-header {
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
				max-width: 820px;
				margin-bottom: 2.5rem;
			}

			.archive-title {
				font-size: clamp(2.2rem, 4.5vw, 3.2rem);
				font-weight: 900;
				margin: 0;
			}

			.archive-desc {
				font-size: 1.15rem;
				color: var(--text-secondary);
				line-height: 1.75;
				margin: 0;
			}

			.filter-controls-box {
				padding: 1.5rem;
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
				margin-top: 1rem;
				border: 1px solid var(--border-subtle);
			}

			.search-input-wrap {
				display: flex;
				align-items: center;
				gap: 0.85rem;
				background: var(--bg-card);
				border: 1px solid var(--border-subtle);
				padding: 0.75rem 1.1rem;
				color: var(--text-muted);
			}

			.search-input-wrap input {
				flex: 1;
				background: transparent;
				border: none;
				outline: none;
				color: var(--text-primary);
				font-size: 1rem;
				font-weight: 600;
			}

			.search-input-wrap input::placeholder {
				color: var(--text-muted);
			}

			.category-pills {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}

			.cat-pill {
				padding: 0.45rem 1rem;
				background: var(--bg-secondary);
				border: 1px solid var(--border-subtle);
				color: var(--text-secondary);
				font-size: 0.88rem;
				font-weight: 600;
				cursor: pointer;
				transition: all 0.15s ease;
			}

			.cat-pill:hover {
				background: var(--bg-card-hover);
				color: var(--text-primary);
				border-color: var(--border-strong);
			}

			.cat-pill.active {
				background: var(--text-primary);
				color: var(--bg-primary);
				border-color: var(--text-primary);
				font-weight: 700;
			}

			.posts-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
				gap: 1.75rem;
			}

			.post-item-card {
				border: 1px solid var(--border-subtle);
				transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
			}

			.post-item-card:hover {
				transform: translateY(-3px);
				border-color: var(--border-highlight);
			}

			.card-inner-link {
				display: flex;
				flex-direction: column;
				height: 100%;
				padding: 1.75rem;
				text-decoration: none;
				color: inherit;
				gap: 1rem;
			}

			.card-top-meta {
				display: flex;
				align-items: center;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 0.5rem;
			}

			.pub-date {
				font-size: 0.82rem;
				color: var(--text-muted);
			}

			.post-card-title {
				margin: 0;
				font-size: 1.25rem;
				font-weight: 800;
				line-height: 1.4;
				color: var(--text-primary);
				transition: color 0.15s ease;
			}

			.post-item-card:hover .post-card-title {
				color: #38bdf8;
			}

			.post-card-excerpt {
				margin: 0;
				font-size: 0.92rem;
				color: var(--text-secondary);
				line-height: 1.65;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.card-footer-meta {
				margin-top: auto;
				padding-top: 1rem;
				border-top: 1px solid var(--border-subtle);
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.5rem;
			}

			.tags-row {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
			}

			.tag-pill {
				font-size: 0.76rem;
				color: #60a5fa;
				font-weight: 600;
			}

			.read-btn {
				font-size: 0.88rem;
				font-weight: 700;
				color: #38bdf8;
				white-space: nowrap;
			}

			.no-results-msg {
				padding: 4rem 1rem;
				text-align: center;
				color: var(--text-muted);
				font-size: 1.1rem;
			}

			@media (max-width: 640px) {
				.posts-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>

		<script>
			const searchInput = document.getElementById('articleSearchInput') as HTMLInputElement;
			const pills = document.querySelectorAll('#categoryPills .cat-pill');
			const cards = document.querySelectorAll('#postsGrid .post-item-card');
			const noResults = document.getElementById('noResultsMsg');

			let activeCategory = '全部';
			let searchQuery = '';

			function filterArticles() {
				let visibleCount = 0;

				cards.forEach(card => {
					const cardEl = card as HTMLElement;
					const cat = cardEl.getAttribute('data-category') || '';
					const title = cardEl.getAttribute('data-title') || '';
					const tags = cardEl.getAttribute('data-tags') || '';

					const matchesCat = (activeCategory === '全部' || cat === activeCategory);
					const matchesQuery = (!searchQuery || title.includes(searchQuery) || tags.includes(searchQuery));

					if (matchesCat && matchesQuery) {
						cardEl.style.display = 'block';
						visibleCount++;
					} else {
						cardEl.style.display = 'none';
					}
				});

				if (noResults) {
					noResults.style.display = visibleCount === 0 ? 'block' : 'none';
				}
			}

			pills.forEach(pill => {
				pill.addEventListener('click', () => {
					pills.forEach(p => p.classList.remove('active'));
					pill.classList.add('active');
					activeCategory = pill.getAttribute('data-category') || '全部';
					filterArticles();
				});
			});

			searchInput?.addEventListener('input', (e) => {
				searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
				filterArticles();
			});
		</script>
	</body>
</html>
